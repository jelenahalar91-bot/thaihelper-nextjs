# The Capacitor shell and its ignore rules were removed on 2026-10-14 —
# the native apps are built from the Expo project in ../thaihelper-mobile.
# Nothing here produces an android/ or ios/ directory any more.

# Local-only operational files — contain real user data (emails, phone
# numbers, ref codes from helper_profiles) or live messaging logs that
# we never want pushed to GitHub. These are scratch files for outreach,
# tester recruitment, internal stats — not source code.
#
# Safety net: even if someone runs `git add .`, none of this ships.
play-store/*.csv
play-store/*.json
marketing/
scripts/outreach/
scripts/check-*.js
scripts/send-*.js
scripts/find-*.js
scripts/dedupe-*.js
scripts/list-*.js
scripts/notify-*.js
check-messaging*.js
messaging-detailed-report.js

# Destructive admin/ops scripts — they hard-delete production rows or
# flip verification flags. Useful locally, but they should never live in
# the public repo where a fresh clone hands anyone a ready-made
# delete-helper tool. Kept on disk (git rm --cached), ignored from here.
scripts/delete-*.js
scripts/flip-*.js
scripts/audit-employer-signups.js

# One-off feedback blast — the send log has PII (recipient emails)
scripts/.feedback-blast-sent.jsonl

# Multi-job announcement blast — send log has PII (recipient emails)
scripts/.multijob-announcement-sent.jsonl

# App-launch blast — send log has PII (recipient emails)
scripts/.app-launch-blast-sent.jsonl

# Moderation audit log — contains account PII
scripts/.suspended-accounts.jsonl

# Scam-warning blast — send log has PII (recipient emails)
scripts/.scam-warning-sent.jsonl

# Unsent reply drafts — contain the reporter's email address
scripts/.drafts-*.md

# Harassment follow-ups — send log has PII (recipient emails)
scripts/.harassment-followup-sent.jsonl

# Phishing-Warnung 27.09. — Versandprotokoll (Helfer-Referenzen)
scripts/.phishing-warning-sent.jsonl

# Listing-completion blast — send log has PII (recipient emails)
scripts/.listing-completion-sent.jsonl

# Deleted duplicate family accounts — the backup holds real emails and messages
scripts/.deleted-accounts.jsonl
